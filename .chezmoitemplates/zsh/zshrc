function get_pcap {
  if [[ -z "$1" ]]; then
    echo "USAGE: get_pcap <HOST>"
    return
  fi
  ssh root@192.168.8.1 "tcpdump -U -s 0 -i br-lan -w - host $1" > ./client.pcap
}

function rfind {
  if [[ -z "$1" ]]; then
    echo "no arguments passed; aborting"
    return
  fi
  mdfind "kMDItemFSName=='*$1*'cd"
}

# list most recent files in pwd
function lr() {
  local n="${1:-5}"
  ls -lt | grep -v '^total' | head -n "$n"
}

utcnow() {
